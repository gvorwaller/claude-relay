# Install as /etc/claude-relay-monitor/web.env, owned by relay-monitor and mode 0600.
# Never commit populated values.
MONITOR_INSTALLATION_ID=home-relay
MONITOR_AGENT_SECRET_FILE=/etc/claude-relay-monitor/agent-secret
MONITOR_CSRF_SECRET_FILE=/etc/claude-relay-monitor/csrf-secret

# Preferred production browser and agent edge authentication.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-human-access-application-audience
CF_ACCESS_AGENT_AUD=replace-with-agent-access-application-audience

# Phase 3 exact-job stop control. Keep disabled until synthetic live acceptance passes.
MONITOR_STOP_DELEGATE_ENABLED=0

# Phase 4 browser admin parity. Every gate defaults off and must also be
# enabled independently on the outbound Mac agent.
MONITOR_ADMIN_RESTART_ENABLED=0
MONITOR_ADMIN_ACTIVITY_CLEANUP_ENABLED=0
MONITOR_ADMIN_CREDENTIAL_REPAIR_ENABLED=0
MONITOR_ADMIN_IDENTITY_REMOVAL_ENABLED=0
MONITOR_ADMIN_MESSAGE_CLEANUP_ENABLED=0
MONITOR_ADMIN_ACTIVITY_CLEANUP_ALL_ENABLED=0
MONITOR_ADMIN_MESSAGE_CLEANUP_ALL_ENABLED=0

# Local/pre-Access fallback only. Remove when CF_ACCESS_* is configured.
# MONITOR_WEB_PASSWORD_FILE=/etc/claude-relay-monitor/web-password
